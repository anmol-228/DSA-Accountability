{
  "manifest_version": 3,
  "name": "DSA Accountability - LeetCode Watcher",
  "version": "1.0.3",
  "description": "Watches LeetCode problem pages for fresh Java Accepted submissions and syncs them to the local DSA Accountability desktop app. No account data is read; nothing leaves your machine.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
